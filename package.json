{
  "name": "zcode-ssh-tui",
  "version": "0.1.0",
  "type": "module",
  "description": "Terminal UI frontend for ZCode, usable over ssh",
  "bin": {
    "zcode-tui": "src/main.js"
  },
  "scripts": {
    "start": "node src/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pty": "RUN_PTY=1 vitest run test/flicker/pty --testTimeout=30000"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "ink": "^7.1.0",
    "ink-text-input": "^6.0.0",
    "marked": "^18.0.6",
    "react": "^19.2.0",
    "strip-ansi": "^7.2.0",
    "wrap-ansi": "^10.0.0"
  },
  "devDependencies": {
    "cli-highlight": "^2.1.11",
    "ink-testing-library": "^4.0.0",
    "vitest": "^4.1.10"
  }
}
